open scoped Matrix ComplexOrder in
/-- The limit covariance (thesis Prop. 4.7). For real $\varphi$, $\lambda$ and a family
$(\gamma_x)$ of real $2 \times 2$ matrices, the limit matrix is
$C(k) = \frac12\bigl(\hat\gamma(k) + N(k)^T \hat\gamma(k) N(k)\bigr)$, and the limit cells are the
real parts $\gamma_{\infty, x} = \operatorname{Re} \frac1{2\pi}\int_{-\pi}^{\pi} e^{ikx}\, C(k)\,
dk$, entrywise. Let $(\varphi, \lambda)$ lie in the regime. For every $k$, $C(k)$ is invariant,
$\hat L(k)^T C(k) \hat L(k) = C(k)$, and if $\hat\gamma(k) + i\Omega$ is positive semidefinite, so
is $C(k) + i\Omega$. If $(\gamma_x)$ are cell data, then every entry of $k \mapsto e^{ikx} C(k)$
is integrable on $[-\pi, \pi]$, the integral $\frac1{2\pi}\int_{-\pi}^{\pi} e^{ikx}\, C(k)\, dk$
is real and hence equal to $\gamma_{\infty, x}$, and $\gamma_{\infty, -x} = \gamma_{\infty, x}^T$
for every $x$; if moreover the cells are reflection symmetric, $\gamma_{-x} = \gamma_x$, and
$\hat\gamma(k) + i\Omega \ge 0$ at the wave number $k$, then $C(k) = g\, \hat\varepsilon(k)$ for a
real number $g \ge 1$ (the form of thesis Theorem 4.8 at this wave number). -/
theorem dyn_limit_covariance (φ lam : ℝ)
    (γc : ℤ → Matrix (Gaussian.PhaseIndex 1) (Gaussian.PhaseIndex 1) ℝ) :
    (∀ k, limitSymbol φ lam γc k = (1 / 2 : ℂ) • (gammaHat γc k +
      ((nMat φ lam k)ᵀ).map Complex.ofReal * gammaHat γc k * (nMat φ lam k).map Complex.ofReal)) ∧
    (∀ (x : ℤ) (a b : Gaussian.PhaseIndex 1), limitCells φ lam γc x a b =
      (((2 * Real.pi)⁻¹ : ℂ) * ∫ k in (-Real.pi)..Real.pi, Complex.exp ((k : ℂ) * x * Complex.I) *
        limitSymbol φ lam γc k a b).re) ∧
    (ExampleRegime φ lam →
      (∀ k, ((exampleSymbol φ lam k)ᵀ).map Complex.ofReal * limitSymbol φ lam γc k *
        (exampleSymbol φ lam k).map Complex.ofReal = limitSymbol φ lam γc k) ∧
      (∀ k, (gammaHat γc k +
          Complex.I • (Gaussian.symplecticForm 1).map Complex.ofReal).PosSemidef →
        (limitSymbol φ lam γc k +
          Complex.I • (Gaussian.symplecticForm 1).map Complex.ofReal).PosSemidef) ∧
      (CellData γc →
        (∀ (x : ℤ) (a b : Gaussian.PhaseIndex 1), IntervalIntegrable
          (fun k : ℝ => Complex.exp ((k : ℂ) * x * Complex.I) * limitSymbol φ lam γc k a b)
          MeasureTheory.volume (-Real.pi) Real.pi) ∧
        (∀ (x : ℤ) (a b : Gaussian.PhaseIndex 1),
          ((2 * Real.pi)⁻¹ : ℂ) * ∫ k in (-Real.pi)..Real.pi,
            Complex.exp ((k : ℂ) * x * Complex.I) * limitSymbol φ lam γc k a b =
              (limitCells φ lam γc x a b : ℂ)) ∧
        (∀ x, limitCells φ lam γc (-x) = (limitCells φ lam γc x)ᵀ) ∧
        ((∀ x, γc (-x) = γc x) → ∀ k,
          (gammaHat γc k + Complex.I • (Gaussian.symplecticForm 1).map Complex.ofReal).PosSemidef →
          ∃ g : ℝ, 1 ≤ g ∧ limitSymbol φ lam γc k = (g • epsHat φ lam k).map Complex.ofReal))) :=
  sorry

